# 飞书自建应用（开发者后台 -> 凭证与基础信息）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 可选：AI 模型（任意 OpenAI 兼容接口，按需三行切换）。
# 不填 AI_API_KEY 时，机器人只运行猜拳等内置动作，便于先验证卡片闭环。
#
# 免费推荐（任选其一）：
# 1) 智谱 GLM-4-Flash（永久免费）            -> base=https://open.bigmodel.cn/api/paas/v4            model=glm-4-flash
# 2) 硅基流动（免费档，DeepSeek/Qwen 等）     -> base=https://api.siliconflow.cn/v1                 model=Qwen/Qwen3-8B
# 3) 阿里百炼 Qwen（新用户约 100 万 token/90 天）-> base=https://dashscope.aliyuncs.com/compatible-mode/v1 model=qwen-flash
# 4) 火山方舟 豆包（字节同生态，新用户送 50 万/30 天）-> base=https://ark.cn-beijing.volces.com/api/v3  model=你的EndpointID
AI_API_BASE=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_MODEL=glm-4-flash

# 可选：导出文档的挂载文件夹 token（飞书云空间文件夹 URL里 fld 开头的串）。
# 不填则挂载到应用云空间根目录。
FEISHU_FOLDER_TOKEN=

# 可选：豆包工作插件通道（doubao-work/ 子包通过它远程建卡，详见 doubao-work/README.md）。
# 1=开启本地控制 API；CONTROL_TOKEN 自定义一串随机字符；FEISHU_DEFAULT_CHAT_ID
# 填目标群/单聊的 chat_id（oc 开头），不填则 MCP 调用必须显式传 chat_id。
MCP_ENABLED=
CONTROL_PORT=3777
CONTROL_TOKEN=
FEISHU_DEFAULT_CHAT_ID=
